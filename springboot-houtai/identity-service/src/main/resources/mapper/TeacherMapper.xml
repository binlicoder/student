<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.binlicoder.houtai.mapper.TeacherMapper">
    <resultMap id="BaseResultMap" type="com.binlicoder.houtai.entity.Teacher">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="teacher_no" property="teacherNo"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="title" property="title"/>
        <result column="department" property="department"/>
        <result column="real_name" property="realName"/>
        <result column="username" property="username"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT t.*, u.real_name, u.username
        FROM teachers t
        LEFT JOIN users u ON t.user_id = u.id
        <where>
            <if test="teacherNo != null and teacherNo != ''">
                AND t.teacher_no LIKE CONCAT('%', #{teacherNo}, '%')
            </if>
            <if test="name != null and name != ''">
                AND u.real_name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*)
        FROM teachers t
        LEFT JOIN users u ON t.user_id = u.id
        <where>
            <if test="teacherNo != null and teacherNo != ''">
                AND t.teacher_no LIKE CONCAT('%', #{teacherNo}, '%')
            </if>
            <if test="name != null and name != ''">
                AND u.real_name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT t.*, u.real_name, u.username
        FROM teachers t
        LEFT JOIN users u ON t.user_id = u.id
        WHERE t.id = #{id}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT t.*, u.real_name, u.username
        FROM teachers t
        LEFT JOIN users u ON t.user_id = u.id
        WHERE t.user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.binlicoder.houtai.entity.Teacher" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO teachers (user_id, teacher_no, gender, phone, email, title, department)
        VALUES (#{userId}, #{teacherNo}, #{gender}, #{phone}, #{email}, #{title}, #{department})
    </insert>

    <update id="update" parameterType="com.binlicoder.houtai.entity.Teacher">
        UPDATE teachers
        <set>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="title != null">title = #{title},</if>
            <if test="department != null">department = #{department},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM teachers WHERE id = #{id}
    </delete>
</mapper>
